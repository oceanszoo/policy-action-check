      "id": "O-hr-review",
      "kind": "obligation",
      "source": "Sensitive uses: qualified human-in-the-loop",
      "effective_from": "2026-11-12",
      "when": {
        "all": [
          {
            "dim": "hr",
            "not_in": [
              "none"
            ]
          },
          {
            "dim": "scope",
            "in": [
              "ind"
            ]
          },
          {
            "dim": "fav",
            "not_in": [
              "full"
            ]
          }
        ]
      },
      "require": {
        "dim": "rev",
        "in": [
          "y"
        ]
      },
      "next_step": "Have a qualified person (licensed where required) review the recommendation, with power to change it, before it is delivered or used.",
      "title": "Qualified human-in-the-loop",
      "source_terms": [
        "c020",
        "c027"
      ]
