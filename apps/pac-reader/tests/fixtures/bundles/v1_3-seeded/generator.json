  "dimensions": [
    {
      "key": "act",
      "name": "actor",
      "values": {
        "con": "consumer user",
        "biz": "business or API developer",
        "agt": "deployed agent"
      },
      "fixable": false,
      "frequency": {
        "biz": 150
      },
      "evidence": "account type / contract (consumer terms vs commercial API agreement); agent deployment config",
      "question": "Who performs the action: a consumer, a business or API developer, or a deployed agent?",
      "default": null
    },
    {
      "key": "pur",
      "name": "what the action does (observable functions; one or more, written a+b)",
      "values": {
        "std": "ordinary function, none of the listed ones (incl. emotion detection for medical or safety use)",
        "data": "private information collection, use or access governed by permission",
        "track": "targeting or tracking identifiable people or their property",
        "imp": "false attribution of an identity or misrepresentation of a persona as human",
        "false": "misleading or deceptive information outside the identity-only satire exception",
        "fake": "deceptive campaign or artificial-activity operation",
        "elect": "prohibited political or electoral deception, suppression or interference",
        "cyber": "security testing, assessment or activity subject to system-owner authorization",
        "infra": "disrupt critical infrastructure",
        "weap": "weapons, including CBRN",
        "viol": "violence, extremism or hate",
        "child": "harm to minors",
        "harm": "self-harm promotion, harassment, harmful imagery or other covered cruel behavior",
        "lawenf": "make law-enforcement or criminal-justice decisions",
        "emo": "natural-person emotion inference outside medical or safety uses",
        "fraud": "scams, phishing, extortion, spam, fake documents, plagiarism",
        "abuse": "platform abuse: reselling, multi-account, distillation, ban evasion, jailbreak",
        "sex": "sexually explicit content",
        "illegal": "other illegal activity",
        "privacyillegal": "use that independently violates applicable privacy rights",
        "profile": "multisource individual profiling for third-party disposition in furtherance of an independently prohibited use",
        "malcode": "creation or dissemination of malicious code or disruptive abuse outside the authorized research context",
        "rating": "social behavior or trustworthiness rating of an individual",
        "surveil": "tools expressly for prohibited surveillance, harmful identification, government censorship, sensitive biometric categorization, or rights-impairing law enforcement",
        "platformauth": "provider output model training or access provision subject to provider authorization"
      },
      "fixable": false,
      "frequency": {
        "std": 126,
        "fraud": 2,
        "data": 7,
        "track": 7,
        "emo": 1,
        "cyber": 5,
        "viol": 2,
        "false": 1,
        "fake": 1,
        "elect": 1,
        "weap": 1,
        "child": 1,
        "sex": 1,
        "illegal": 1
      },
      "evidence": "what the action does or produces, judged from the request, output or tool call, not from stated intentions",
      "multi": true,
      "question": "What does the action do? Pick every function that applies.",
      "default": null
    },
    {
      "key": "auth",
      "name": "authorization of the target",
      "values": {
        "na": "no target system",
        "own": "own/operated system, owner-authorized activity, or explicitly in scope of a security disclosure program",
        "unauth": "unauthorized target"
      },
      "fixable": false,
      "frequency": {
        "own": 4,
        "unauth": 1
      },
      "evidence": "written authorization or ownership record for the target system (scope letter, bug bounty terms)",
      "question": "Is the target system yours or are you authorized to test it?"
    },
    {
      "key": "cons",
      "name": "consent of affected people",
      "values": {
        "na": "no affected people",
        "y": "they agreed",
        "n": "they did not agree"
      },
      "fixable": true,
      "frequency": {
        "n": 1,
        "y": 6
      },
      "evidence": "Consent or permission record covering these people, intended activity and data.",
      "question": "Did the affected people agree to this specific collection, disclosure, tracking, or rating?"
    },
    {
      "key": "fic",
      "name": "framing",
      "values": {
        "na": "not relevant",
        "lab": "clearly labelled parody, satire or fiction",
        "real": "presented as real"
      },
      "fixable": false,
      "frequency": {
        "lab": 4,
        "real": 1
      },
      "evidence": "label visible in the published work itself",
      "question": "Is the content clearly labelled as parody, satire or fiction, or presented as real?"
    },
    {
      "key": "hr",
      "name": "high-risk recommendation area",
      "values": {
        "none": "none",
        "legal": "legal",
        "med": "medical or mental health",
        "fin": "finance",
        "credit": "credit",
        "ins": "insurance",
        "housing": "housing",
        "emp": "employment",
        "edu": "education or credentials",
        "health": "healthcare access",
        "benefit": "public benefits",
        "status": "legal status"
      },
      "fixable": false,
      "frequency": {
        "legal": 11,
        "none": 114,
        "emp": 7,
        "ins": 14,
        "med": 4
      },
      "default": null,
      "evidence": "the subject matter of the output (legal, medical, credit, ...) as written",
      "question": "Does the output recommend something in one of these high-risk areas?"
    },
    {
      "key": "scope",
      "name": "recommendation scope",
      "values": {
        "na": "no recommendation",
        "ind": "about a specific individual, delivered or used for a decision",
        "nc": "not covered: education, wellness, internal drafting not ultimately used as recommendation, explanation of given advice, fixed rules, or nonspecific business operations"
      },
      "fixable": false,
      "frequency": {
        "nc": 123,
        "ind": 27
      },
      "default": null,
      "evidence": "whether the output names a specific person and is delivered to them or used for their decision",
      "question": "Is the recommendation about a specific person and delivered to them or used to decide about them?"
    },
    {
      "key": "fav",
      "name": "decision direction",
      "values": {
        "na": "no decision",
        "full": "one of the enumerated wholly favorable decisions: full claim payment, ordered care coverage or authorization, healthcare eligibility, or public benefits",
        "part": "anything else, incl. partial or conditional"
      },
      "fixable": false,
      "frequency": {
        "na": 123,
        "part": 23,
        "full": 4
      },
      "default": null,
      "evidence": "the decision's content: full approval of a listed decision vs anything else",
      "question": "Which direction is the decision?"
    },
    {
      "key": "rev",
      "name": "qualified human review before delivery or use",
      "values": {
        "y": "yes",
        "n": "no"
      },
      "fixable": true,
      "frequency": {
        "n": 6,
        "y": 13
      },
      "evidence": "Substantive review log, editing authority, and reviewer qualifications including license where legally required.",
      "question": "Before delivery or decision use, did a qualified person meaningfully review this recommendation with authority to change it?"
    },
    {
      "key": "disc",
      "name": "AI contribution notice to affected individual",
      "values": {
        "y": "yes",
        "n": "no"
      },
      "fixable": true,
      "frequency": {
        "n": 5,
        "y": 15
      },
      "evidence": "The delivered decision notice or advice copy and the recipient record.",
      "question": "Is the recipient or subject clearly told that AI produced the recommendation?"
    },
    {
      "key": "chat",
      "name": "consumer-facing chatbot or agent",
      "values": {
        "y": "yes",
        "n": "no"
      },
      "fixable": false,
      "frequency": {
        "n": 150
      },
      "default": null,
      "evidence": "User-facing interaction and interface records, not the support team name.",
      "question": "Does a consumer-facing chatbot or AI agent communicate directly with external users?"
    },
    {
      "key": "phys",
      "name": "physical action",
      "values": {
        "none": "none",
        "hi": "hardware acts without prior human approval in a covered movement, injury, hazardous-energy, bodily-action, safety-system or industrial category",
        "nc": "excluded: bounded low-consequence consumer device, qualified pre-execution review, read-only monitoring, or enclosed nonhazardous lab operation"
      },
      "fixable": false,
      "frequency": {
        "none": 135,
        "nc": 5,
        "hi": 10
      },
      "default": null,
      "evidence": "Control path, pre-execution approval records, operating environment and tested constraints.",
      "question": "Does the output control covered hardware without prior human approval, or is it excluded or not a hardware action?"
    },
    {
      "key": "stop",
